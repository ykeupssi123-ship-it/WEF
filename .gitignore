# Etat/logs d'exploitation - propres a chaque machine, jamais versionnes
state/*
!state/.gitkeep
logs/*
!logs/.gitkeep

# AJOUTE LE 2026-09-24 (trouve en verifiant l'alignement du kit Windows) :
# un motif avec un "/" au milieu ("state/*") est ANCRE A LA RACINE du
# depot en gitignore - jamais recursif automatiquement dans un
# sous-dossier comme jobs_windows/. Sans ces lignes explicites, l'etat/
# les logs/le MSI telecharge du kit Windows auraient fini par etre
# commites par erreur au premier "git add -A" ou equivalent.
jobs_windows/state/*
jobs_windows/logs/*
jobs_windows/*.msi
jobs_windows/*.zip

# Secrets generes a l'execution - jamais versionnes (voir secrets/README_SECRETS.txt)
secrets/*
!secrets/README_SECRETS.txt

# Python
__pycache__/
*.pyc

# Fichiers temporaires d'edition
*.wef_tmp
*~
.DS_Store
Thumbs.db

# Anciennes sauvegardes de vars.conf (mecanisme retire le 2026-09-09 -
# voir jobs/lib/skip_jobs_toggle.sh - peut trainer sur une VM deja
# deployee avant ce correctif)
vars.conf.bak_*

# Identite de CETTE machine (ROLE/AGENT_NAME/...) - AJOUTE LE 2026-09-13
# (demande explicite : un "git pull" ne doit plus jamais entrer en
# conflit avec la config propre a une machine). Voir vars.local.conf.example.
vars.local.conf
